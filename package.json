{
  "name": "unified-discord-ai-bot",
  "version": "0.2.0",
  "description": "A provider-neutral conversational AI bot for Discord.",
  "private": true,
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env index.js",
    "register": "node --env-file-if-exists=.env scripts/register.js",
    "check:providers": "node --env-file-if-exists=.env scripts/check-providers.js",
    "lint": "eslint .",
    "check": "node scripts/check.js",
    "test": "node --test \"test/*.test.js\""
  },
  "dependencies": {
    "@google/genai": "^3.6.1",
    "discord.js": "^14.28.1",
    "openai": "^7.64.0"
  },
  "devDependencies": {
    "eslint": "^10.15.0"
  },
  "engines": {
    "node": ">=24.17.0 <25"
  },
  "keywords": [
    "discord-bot",
    "conversational-ai",
    "discord"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ItzRandom/Gemini-Discord"
  },
  "bugs": {
    "url": "https://github.com/ItzRandom/Gemini-Discord/issues"
  },
  "homepage": "https://github.com/ItzRandom/Gemini-Discord#readme",
  "author": "Itz Random",
  "license": "MIT"
}

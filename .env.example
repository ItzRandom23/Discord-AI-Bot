# Discord
# Name shown in /ai settings. Set the Discord profile name separately in the Developer Portal.
APP_NAME=Discord AI
# Bot token from Developer Portal > Bot. It lets this process log in and register slash commands. Keep it private.
DISCORD_TOKEN=
# Application ID from Developer Portal > General Information. It identifies the app whose commands are registered.
DISCORD_APPLICATION_ID=
# Leave blank to register slash commands globally, for every server that installs the bot.
# Set a test server ID only when you want registration scoped to that server.
DISCORD_COMMAND_GUILD_ID=
# Optional channel ID for public Gemini replies to ordinary messages. Blank keeps the bot in slash-command mode.
DISCORD_LEGACY_CHANNEL_ID=

# Google Gemini
# Key from Google AI Studio. It enables Gemini. Leave blank to turn off Gemini.
GEMINI_API_KEY=
# JSON list of selectable Gemini models. The image and streaming flags mark what each model supports.
GEMINI_MODELS='[{"id":"gemini-3.8-flash","image":true,"streaming":true}]'
# Gemini model used when the chat command omits the model. Blank uses the first entry in GEMINI_MODELS.
GEMINI_DEFAULT_MODEL=

# OpenAI
# Key from the OpenAI API dashboard. It enables OpenAI. Leave blank to turn off OpenAI.
OPENAI_API_KEY=
# JSON list of selectable OpenAI models. The image and streaming flags mark what each model supports.
OPENAI_MODELS='[{"id":"gpt-4.1-mini","image":true,"streaming":true}]'
# OpenAI model used when the chat command omits the model. Blank uses the first entry in OPENAI_MODELS.
OPENAI_DEFAULT_MODEL=

# Provider selection and fallback
# Provider used when the chat command omits one. Set gemini or openai, or leave blank to use the first enabled provider.
AI_DEFAULT_PROVIDER=
# Comma-separated providers to try in order if the chosen provider fails. Blank disables fallback.
# The user must opt in for each request. Only the current text goes to the fallback provider.
AI_FALLBACK_PROVIDERS=

# Conversation history and server settings
# Folder for server settings and any encrypted history. Relative paths start from the bot's working directory.
AI_STATE_DIR=.bot-data
# Minutes after the last saved turn before that conversation expires. Set 0 to disable saving history.
AI_HISTORY_MINUTES=60
# Maximum number of prompt-and-reply pairs kept per conversation, subject to the context length limit.
AI_HISTORY_TURNS=6
# Maximum number of saved conversations across the whole bot. The oldest are removed when the limit is reached.
AI_MAX_SESSIONS=1500

# Prompt, reply, and attachment limits
# Maximum characters in one user prompt.
AI_MAX_PROMPT_CHARS=2000
# Maximum text characters sent in the current prompt and previous turns combined. Raise it to keep more context.
AI_MAX_CONTEXT_CHARS=12000
# Maximum reply characters shown in Discord. The bot splits long replies across messages and cuts them at this limit.
AI_MAX_OUTPUT_CHARS=8000
# Maximum output tokens requested from the provider. Lower values can shorten replies and reduce usage.
AI_MAX_OUTPUT_TOKENS=2048
# Maximum size of one image upload in KiB. Set 0 to disable images or 1024 for a 1 MiB limit.
# The selected model must also support image input.
AI_MAX_IMAGE_KIB=0
# Set true to show partial replies as they arrive for supported models. Users can turn streaming off per request.
AI_STREAMING_ENABLED=false

# Provider timeouts and retries
# Time limit in milliseconds for downloading the attachment and getting an AI reply. 45000 is 45 seconds.
AI_TIMEOUT_MS=45000
# Set 1 to retry once after a short provider rate-limit response. Set 0 to disable retries.
AI_RATE_LIMIT_RETRIES=1

# Request and concurrency limits
# Duration of each request limit window in milliseconds. 60000 is one minute.
AI_RATE_WINDOW_MS=60000
# Maximum AI requests per Discord user in each window, across all servers.
AI_USER_REQUESTS=4
# Maximum AI requests from any one Discord server in each window.
AI_GUILD_REQUESTS=30
# Maximum AI requests across the entire bot in each window.
AI_GLOBAL_REQUESTS=120
# Maximum AI requests that can run at the same time across the whole bot.
AI_MAX_CONCURRENT=8
# Maximum AI requests that can run at the same time in one server. Must be at most AI_MAX_CONCURRENT.
AI_MAX_GUILD_CONCURRENT=2

# Optional encrypted history
# Leave blank to keep history in memory. Set a base64-encoded 32-byte key to save encrypted history to disk.
# Keep the key private. The same key is needed to read existing saved history.
AI_HISTORY_KEY=
